{
  "name": "ompdesk",
  "version": "0.4.0",
  "description": "Desktop GUI client for oh-my-pi (omp) — the terminal AI coding agent. Streaming chat, tool calls, sessions, MCP & Skills management. Windows · macOS · Linux",
  "main": "./out/main/index.js",
  "author": {
    "name": "amiliyaai",
    "email": "amiliyaai@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amiliyaai/OmpDesk.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:win": "npm run build && npm run pack:win",
    "build:mac": "npm run build && npm run pack:mac",
    "build:linux": "npm run build && npm run pack:linux",
    "pack:win": "electron-builder --win --publish never",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:linux": "electron-builder --linux --publish never",
    "pack:dir": "electron-builder --dir --publish never",
    "smoke": "npx tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  }
}
